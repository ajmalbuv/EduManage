# =============================================================================
# EduManage Production Environment Configuration
# Save as: ~/.config/edumanage/app.env (chmod 600)
# =============================================================================

# Django Secret Key (generate a strong random secret key):
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key

# Production Settings
DEBUG=False
PORT=8000
ALLOWED_HOSTS=ajmalbasheer.duckdns.org,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://ajmalbasheer.duckdns.org
SECURE_SSL_REDIRECT=True

# Point this to your existing PostgreSQL database:
DATABASE_URL=postgres://user:password@host.containers.internal:5432/edumanage

# Static files directory inside container:
STATIC_ROOT=/app/staticfiles

# Automatically run database migrations on container startup:
RUN_MIGRATIONS=true

# Automatically collect static files on container startup:
COLLECT_STATIC=true

# Gunicorn configuration
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
